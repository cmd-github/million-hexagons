{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "million-hexagons-staging",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "main": "deploy/staging-worker.js",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/artwork/*"],
    "directory": "./staging-dist",
    "not_found_handling": "none"
  }
}
