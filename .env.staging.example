# Copy to .env.staging.local. Keep credentials out of VITE_* variables.
# Initial staging may use the bucket's public development URL.
MH_ASSET_ORIGIN=https://pub-REPLACE.r2.dev
MH_R2_BUCKET=million-hexagons-staging-public
CLOUDFLARE_ACCOUNT_ID=
MH_R2_ACCESS_KEY_ID=
MH_R2_SECRET_ACCESS_KEY=
# Optional for unattended Worker deploy; interactive local use: npm exec wrangler login
CLOUDFLARE_API_TOKEN=
